{
  "expo": {
    "name": "Salah",
    "slug": "salah",
    "scheme": "salah",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F5F0",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.salah.prayertracker",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "app.salah.prayertracker",
      "adaptiveIcon": {
        "backgroundColor": "#1F4D3F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Salah uses your location only to calculate the five daily prayer times on your device."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Salah uses the camera to take a photo of your prayer space as proof of prayer. Photos stay on your device.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1F4D3F",
          "sounds": [
            "./assets/sounds/chime.wav",
            "./assets/sounds/bell.wav",
            "./assets/sounds/soft.wav"
          ]
        }
      ],
      "expo-audio"
    ]
  }
}
