{
  "expo": {
    "name": "Salah",
    "slug": "salah",
    "scheme": "salah",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F5F0",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.salah.prayertracker",
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      }
    },
    "android": {
      "package": "app.salah.prayertracker",
      "adaptiveIcon": {
        "backgroundColor": "#1F4D3F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#10241E",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      "expo-router",
      "expo-font",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Salah uses your location only to calculate the five daily prayer times on your device."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Salah uses the camera to take a photo of your prayer space as proof of prayer. Photos stay on your device.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1F4D3F",
          "sounds": [
            "./assets/sounds/chime.wav",
            "./assets/sounds/bell.wav",
            "./assets/sounds/soft.wav"
          ],
          "icon": "./assets/notification-icon.png"
        }
      ],
      "expo-audio",
      "./plugins/withWidgetAnswerReceiver",
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "SalahWidget",
              "displayName": "Salah",
              "description": "Mark today's prayers from the home screen.",
              "ios": null,
              "android": {
                "minWidth": 250,
                "minHeight": 110,
                "targetCellWidth": 4,
                "targetCellHeight": 2,
                "resizeMode": "horizontal",
                "initialLayout": "src/features/widget/salahWidget.tsx"
              }
            }
          ]
        }
      ],
      "./plugins/withWidgetPlaceholder"
    ],
    "description": "A calm prayer tracker: five daily prayer times, an alarm that stops with proof of prayer, and a year at a glance."
  }
}
